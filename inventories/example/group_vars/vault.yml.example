---
# Скопируйте в vault.yml, замените значения и зашифруйте файл:
# ansible-vault encrypt inventories/example/group_vars/vault.yml
vault_kafka_admin_password: CHANGE_ME_admin_long_random
vault_kafka_keystore_password: CHANGE_ME_keystore_long_random
vault_kafka_truststore_password: CHANGE_ME_truststore_long_random
vault_kafka_producer_password: CHANGE_ME_producer_long_random
vault_kafka_clickhouse_password: CHANGE_ME_clickhouse_long_random

